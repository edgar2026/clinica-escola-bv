{
  "name": "clinica-escola-uninassau",
  "version": "1.0.0",
  "description": "Sistema de Controle de Ponto e Agendamento da Clínica-Escola UNINASSAU",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node backend/server.js",
    "start:prod": "cross-env NODE_ENV=production node backend/server.js",
    "test": "node backend/test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "vite": "^5.1.6"
  }
}
